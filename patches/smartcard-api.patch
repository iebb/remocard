+                }
+                if (channelNumber > 0) {
+                    CommandApdu manageChannelClose = new CommandApdu(
+                            ISO7816.CLA_INTERINDUSTRY,
+                            ISO7816.INS_MANAGE_CHANNEL,
+                            (byte) 0x80,
+                            (byte) channelNumber);
+                    protocolTransmit(manageChannelClose.toByteArray());
+                }
+            } catch (Exception e) {
+                Log.e(TAG, "Error during internalCloseLogicalChannel", e);
+                error.set(e);
+            }
+        }
